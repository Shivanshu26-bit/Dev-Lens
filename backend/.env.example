# DevLens Backend Configuration Example
# Copy this file to .env and fill in the values for local development.

# FastAPI Core Settings
PROJECT_NAME="DevLens"
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# PostgreSQL Database (Phase 5A)
# Default for Local Dev: postgresql+psycopg://devlens:devlens@localhost:5432/devlens
DATABASE_URL=postgresql+psycopg://devlens:devlens@localhost:5432/devlens

# GitHub OAuth Configuration (Phase 5B)
# Register OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Session Security (Phase 5B)
SECRET_KEY=devlens-local-dev-secret-key-change-in-production
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:5173

# Server & Startup Settings
WEB_CONCURRENCY=2
RUN_MIGRATIONS=true


# GitHub API Token (Optional, for higher rate limits)
# Create a Personal Access Token (PAT) with repo access
GITHUB_TOKEN=your_github_token_here

# Gemini API Key for AI Analysis (Phase 4)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Evidence Selection Limits (Phase 4)
MAX_EVIDENCE_FILES=12
MAX_CHARS_PER_FILE=12000
MAX_TOTAL_EVIDENCE_CHARS=60000
AI_REQUEST_TIMEOUT_SECONDS=30.0

# API Rate Limiting Configuration
# Rate limiter uses in-memory storage ("memory://") by default for single-worker/local setups.
# For production multi-worker or multi-instance deployments on Render, supply REDIS_URL
# to coordinate rate limit counters across workers (e.g. redis://red-xxx:6379 or redis://localhost:6379/0).
RATE_LIMIT_ENABLED=true
REDIS_URL=
RATE_LIMIT_STORAGE_URL=
RATE_LIMIT_AUTH_LOGIN=20/minute
RATE_LIMIT_ANALYZE=30/minute
RATE_LIMIT_AI_ANALYZE=10/minute
