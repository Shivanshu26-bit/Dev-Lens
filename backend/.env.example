# DevLens Backend Configuration Example
# Copy this file to .env and fill in the values for local development.

# FastAPI Core Settings
PROJECT_NAME="DevLens"
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# PostgreSQL Database (Future use)
# Default for Docker Dev: postgresql://postgres:postgres@db:5432/devlens
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devlens

# GitHub API Token (Future use)
# Create a Personal Access Token (PAT) with repo access
GITHUB_TOKEN=your_github_token_here

# Gemini API Key for AI Analysis (Future use)
GEMINI_API_KEY=your_gemini_api_key_here
