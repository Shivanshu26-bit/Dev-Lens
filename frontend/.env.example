# DevLens Frontend Configuration Example
# Copy this file to .env or set environment variables during production build.

# Backend API base URL
# Local Development default: http://localhost:8000
# Reverse Proxy / Same-Origin production deployment: leave empty (VITE_API_URL=)
# Cross-Origin production deployment: https://api.devlens.example.com
VITE_API_URL=http://localhost:8000
